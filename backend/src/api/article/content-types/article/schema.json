{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Engineering insights and tech blog publications"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "excerpt": {
      "type": "text"
    },
    "content": {
      "type": "richtext"
    },
    "category": {
      "type": "string",
      "default": "Architecture"
    },
    "author": {
      "type": "string",
      "default": "Eka Prasetyo"
    },
    "readingTime": {
      "type": "string",
      "default": "5 min read"
    },
    "tags": {
      "type": "json"
    },
    "coverUrl": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
