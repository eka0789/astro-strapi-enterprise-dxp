# Host & Server Configuration
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
APP_KEYS=novasphere_key_alpha,novasphere_key_beta,novasphere_key_gamma,novasphere_key_delta
API_TOKEN_SALT=novasphere_token_salt_production_key_443
ADMIN_JWT_SECRET=novasphere_admin_jwt_secret_token_key_change_in_prod
TRANSFER_TOKEN_SALT=novasphere_transfer_token_salt_67890

# Database Configuration (Supabase PostgreSQL Connection)
# Either provide DATABASE_URL (Transaction Pooler or Direct Connection):
DATABASE_URL=postgresql://postgres.yourprojectref:YourStrongPassword123@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Or provide discrete credentials:
DATABASE_CLIENT=postgres
DATABASE_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_NAME=postgres
DATABASE_USERNAME=postgres.yourprojectref
DATABASE_PASSWORD=YourSupabasePasswordHere
DATABASE_SSL=true
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
