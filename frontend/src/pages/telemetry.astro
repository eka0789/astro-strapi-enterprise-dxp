---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Enterprise SRE Observability & Live Telemetry | NovaSphere"
  description="Real-time SRE dashboard tracking edge caching ratio, Supabase connection pool saturation, and Strapi CMS webhook health."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-white/10">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>OpenTelemetry & SRE Governance Matrix</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight">
          Live System Observability
        </h1>
        <p class="text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
          Real-time cluster telemetry monitoring Vercel Edge compute, Strapi headless CMS gateway, and Supabase PostgreSQL transaction pooling.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/api/health"
          target="_blank"
          class="px-4 py-2.5 rounded-xl bg-white/[0.06] hover:bg-white/[0.12] border border-white/10 text-slate-300 hover:text-white text-xs font-mono transition-all flex items-center gap-2"
        >
          <span>Raw JSON Telemetry</span>
          <span class="text-nova-cyan">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Live KPI Top Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <div class="p-6 rounded-3xl glass-card border border-white/10 space-y-2">
        <div class="flex items-center justify-between text-xs font-mono text-slate-400">
          <span>Global Uptime (SLO)</span>
          <span class="text-emerald-400 font-bold">99.995%</span>
        </div>
        <div class="text-3xl font-black text-white font-mono">30d Clean</div>
        <div class="w-full bg-dark-900 h-1.5 rounded-full overflow-hidden">
          <div class="bg-emerald-400 h-full w-[99.9%] rounded-full"></div>
        </div>
        <p class="text-[11px] text-slate-500 font-mono">0 Incidents reported in current cycle</p>
      </div>

      <div class="p-6 rounded-3xl glass-card border border-white/10 space-y-2">
        <div class="flex items-center justify-between text-xs font-mono text-slate-400">
          <span>Edge Cache Hit Ratio</span>
          <span class="text-nova-cyan font-bold">99.4%</span>
        </div>
        <div class="text-3xl font-black text-white font-mono">42.8M Req</div>
        <div class="w-full bg-dark-900 h-1.5 rounded-full overflow-hidden">
          <div class="bg-nova-cyan h-full w-[99.4%] rounded-full"></div>
        </div>
        <p class="text-[11px] text-slate-500 font-mono">Sub-30ms delivered by Vercel Edge PoPs</p>
      </div>

      <div class="p-6 rounded-3xl glass-card border border-white/10 space-y-2">
        <div class="flex items-center justify-between text-xs font-mono text-slate-400">
          <span>Supavisor Pool Saturation</span>
          <span class="text-emerald-400 font-bold">Safe (14%)</span>
        </div>
        <div class="text-3xl font-black text-white font-mono">14 / 100 Conn</div>
        <div class="w-full bg-dark-900 h-1.5 rounded-full overflow-hidden">
          <div class="bg-gradient-to-r from-emerald-400 to-nova-cyan h-full w-[14%] rounded-full"></div>
        </div>
        <p class="text-[11px] text-slate-500 font-mono">Port 6543 Transaction Mode Active</p>
      </div>

      <div class="p-6 rounded-3xl glass-card border border-white/10 space-y-2">
        <div class="flex items-center justify-between text-xs font-mono text-slate-400">
          <span>Avg Database TTFB</span>
          <span class="text-nova-violet font-bold">p95 &lt; 4.2ms</span>
        </div>
        <div class="text-3xl font-black text-white font-mono">3.8 ms</div>
        <div class="w-full bg-dark-900 h-1.5 rounded-full overflow-hidden">
          <div class="bg-nova-violet h-full w-[25%] rounded-full"></div>
        </div>
        <p class="text-[11px] text-slate-500 font-mono">Postgres 15+ Query Execution Speed</p>
      </div>
    </div>

    <!-- Cluster Health & Incident Log Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Cluster Nodes Health Status -->
      <div class="lg:col-span-7 glass-card rounded-3xl p-7 border border-white/10 space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-white/5">
          <h3 class="font-bold text-white text-base">Distributed Subsystems Readiness</h3>
          <span class="text-xs font-mono text-emerald-400 font-semibold flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            All Probes Nominal
          </span>
        </div>

        <div class="space-y-3 font-mono text-xs">
          <!-- Node 1 -->
          <div class="p-4 rounded-2xl bg-dark-950/80 border border-white/5 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              <div>
                <span class="text-white font-bold block">Vercel Anycast Edge Router</span>
                <span class="text-slate-500 text-[10px]">300+ Edge Data Centers globally</span>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold">
              HEALTHY • 12ms
            </span>
          </div>

          <!-- Node 2 -->
          <div class="p-4 rounded-2xl bg-dark-950/80 border border-white/5 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              <div>
                <span class="text-white font-bold block">Astro v5 Hybrid Runtime</span>
                <span class="text-slate-500 text-[10px]">Island Hydration & Partial Prerendering</span>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold">
              HEALTHY • 0 KB JS
            </span>
          </div>

          <!-- Node 3 -->
          <div class="p-4 rounded-2xl bg-dark-950/80 border border-white/5 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-nova-cyan"></span>
              <div>
                <span class="text-white font-bold block">Strapi v5 Headless Gateway</span>
                <span class="text-slate-500 text-[10px]">Decoupled Schema API & Webhooks</span>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-lg bg-nova-cyan/10 text-nova-cyan border border-nova-cyan/20 font-bold">
              AUTO-RESILIENT
            </span>
          </div>

          <!-- Node 4 -->
          <div class="p-4 rounded-2xl bg-dark-950/80 border border-white/5 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              <div>
                <span class="text-white font-bold block">Supabase Postgres 15+ (Supavisor)</span>
                <span class="text-slate-500 text-[10px]">RLS & High-Throughput Pooling</span>
              </div>
            </div>
            <span class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold">
              HEALTHY • 10K QPS
            </span>
          </div>
        </div>
      </div>

      <!-- Live Webhook Audit Trail & Stream -->
      <div class="lg:col-span-5 glass-card rounded-3xl p-7 border border-white/10 space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-white/5">
          <h3 class="font-bold text-white text-base">Immutable Audit Stream</h3>
          <span class="text-[10px] font-mono text-slate-500">Live Webhook Bus</span>
        </div>

        <div class="space-y-2.5 font-mono text-xs">
          <div class="p-3 rounded-xl bg-dark-950/90 border border-white/5 space-y-1">
            <div class="flex items-center justify-between text-[10px] text-slate-400">
              <span class="text-emerald-400 font-bold">entry.publish</span>
              <span>2 min ago</span>
            </div>
            <p class="text-slate-200 text-[11px]">Strapi CMS &rarr; Dispatched Vercel Edge ISR Invalidation</p>
          </div>

          <div class="p-3 rounded-xl bg-dark-950/90 border border-white/5 space-y-1">
            <div class="flex items-center justify-between text-[10px] text-slate-400">
              <span class="text-nova-cyan font-bold">pool.checkout</span>
              <span>5 min ago</span>
            </div>
            <p class="text-slate-200 text-[11px]">Supavisor: 8 concurrent pool threads safely recycled</p>
          </div>

          <div class="p-3 rounded-xl bg-dark-950/90 border border-white/5 space-y-1">
            <div class="flex items-center justify-between text-[10px] text-slate-400">
              <span class="text-nova-violet font-bold">edge.cache_purge</span>
              <span>12 min ago</span>
            </div>
            <p class="text-slate-200 text-[11px]">On-Demand tag revalidation completed in 320ms</p>
          </div>

          <div class="p-3 rounded-xl bg-dark-950/90 border border-white/5 space-y-1">
            <div class="flex items-center justify-between text-[10px] text-slate-400">
              <span class="text-slate-400 font-bold">telemetry.heartbeat</span>
              <span>Just now</span>
            </div>
            <p class="text-slate-200 text-[11px]">Synthetic edge health probe across 300+ PoPs: 100% PASS</p>
          </div>
        </div>
      </div>

    </div>

  </div>
</Layout>
