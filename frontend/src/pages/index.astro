---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ArchitectureMatrix from '../components/ArchitectureMatrix.astro';
import SystemFlowVisualizer from '../components/SystemFlowVisualizer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getProjects, getArticles, getServices } from '../lib/strapi';

const { projects, source: projectSource } = await getProjects();
const { articles } = await getArticles();
const { services } = await getServices();

const featuredProjects = projects.filter((p) => p.featured).slice(0, 2);
const recentArticles = articles.slice(0, 3);
---

<Layout
  title="NovaSphere | Enterprise DXP Architecture (Astro + Strapi + Supabase)"
  description="Next-generation Enterprise DXP Platform designed with Astro v5, Strapi Headless CMS, Supabase PostgreSQL, and deployed to Vercel."
>
  <!-- Hero Section -->
  <Hero source={projectSource} />

  <!-- Main System Flow Visualizer -->
  <section class="py-14 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SystemFlowVisualizer />
  </section>

  <!-- Four Pillars Architecture Matrix -->
  <ArchitectureMatrix />

  <!-- Featured Projects & Case Studies -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-nova-cyan/10 border border-nova-cyan/30 text-nova-cyan text-xs font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-nova-cyan animate-pulse"></span>
          <span>Enterprise Case Studies</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Featured Deployments & Solutions
        </h2>
        <p class="text-slate-400 text-sm sm:text-base max-w-xl leading-relaxed">
          Mission-critical platforms built on decoupled architecture with ultra-high availability, low-latency edge delivery, and secure relational data modeling.
        </p>
      </div>

      <a
        href="/projects"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-white/[0.06] hover:bg-white/[0.12] text-slate-200 hover:text-white border border-white/10 hover:border-nova-cyan/50 transition-all duration-300 text-xs font-bold w-fit shadow-md group"
      >
        <span>View All {projects.length} Case Studies</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {featuredProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <!-- Architectural Services & Offerings -->
  <section class="py-24 bg-dark-900/50 border-y border-white/5 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-nova-violet/10 border border-nova-violet/30 text-nova-violet text-xs font-mono">
          <span>Fullstack Solutions</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Solution Architect Core Competencies
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          From micro-frontend migration to database tuning, headless CMS authoring pipelines, and automated multi-environment CI/CD on Vercel.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="glass-card rounded-3xl p-8 flex flex-col justify-between border border-white/[0.08] hover:border-nova-cyan/40 transition-all duration-500 hover:-translate-y-2 shadow-xl">
            <div class="space-y-4">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-nova-indigo/30 to-nova-cyan/30 border border-white/10 flex items-center justify-center text-nova-cyan font-mono text-2xl shadow-lg">
                ⚡
              </div>
              <h3 class="text-xl font-bold text-white">
                {service.name}
              </h3>
              <p class="text-xs text-nova-cyan font-mono font-semibold">
                {service.tagline}
              </p>
              <p class="text-xs text-slate-400 leading-relaxed">
                {service.description}
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-white/5 space-y-3">
              <span class="text-[10px] font-mono text-slate-500 uppercase tracking-wider font-bold">Key Architectural Deliverables</span>
              <ul class="space-y-2">
                {service.deliverables.map((item) => (
                  <li class="text-xs text-slate-300 flex items-center gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Engineering Insights Blog Preview -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Engineering Blog</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
          Insights & System Notes
        </h2>
        <p class="text-slate-400 text-sm sm:text-base max-w-xl leading-relaxed">
          Deep-dives into Astro Island architecture, Supabase PostgreSQL transaction pooling, Strapi governance workflows, and Vercel edge deployment patterns.
        </p>
      </div>

      <a
        href="/blog"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-white/[0.06] hover:bg-white/[0.12] text-slate-200 hover:text-white border border-white/10 hover:border-nova-violet/50 transition-all duration-300 text-xs font-bold w-fit shadow-md group"
      >
        <span>Explore All Articles</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {recentArticles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </section>

  <!-- Interactive Call to Action Banner -->
  <section class="pb-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl p-8 sm:p-14 lg:p-18 overflow-hidden glass-panel border border-nova-indigo/30 shadow-2xl">
      <!-- Ambient Lights -->
      <div class="absolute -top-28 -right-28 w-[450px] h-[450px] bg-nova-cyan/20 blur-3xl rounded-full pointer-events-none"></div>
      <div class="absolute -bottom-28 -left-28 w-[450px] h-[450px] bg-nova-violet/20 blur-3xl rounded-full pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl space-y-6">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 text-white text-xs font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span>Ready for Deployment</span>
        </div>
        <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight">
          Ready to deploy NovaSphere to your own infrastructure?
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Clone the repository, configure your Supabase connection string and Strapi credentials, and push to Vercel with one-click automatic edge optimization.
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <a
            href="https://github.com/eka0789/astro-strapi-enterprise-dxp"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-2xl font-bold text-sm text-white bg-gradient-to-r from-nova-indigo via-nova-violet to-nova-cyan hover:opacity-95 shadow-xl shadow-nova-indigo/30 hover:shadow-nova-cyan/40 hover:scale-[1.02] transition-all duration-300"
          >
            Star & Clone on GitHub
          </a>
          <a
            href="/architecture"
            class="px-8 py-4 rounded-2xl font-semibold text-sm text-slate-200 bg-white/10 hover:bg-white/15 border border-white/10 hover:border-nova-cyan/40 transition-all duration-300"
          >
            Read Solution Architect Guide
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
