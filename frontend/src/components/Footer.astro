---
const currentYear = new Date().getFullYear();
---

<footer class="relative border-t border-white/10 bg-dark-950 pt-16 pb-12 overflow-hidden">
  <!-- Glow Accent -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-32 bg-nova-indigo/10 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-white/5">
      <!-- Brand column -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-nova-indigo to-nova-cyan p-[1px]">
            <div class="w-full h-full bg-dark-950 rounded-[7px] flex items-center justify-center">
              <svg class="w-4 h-4 text-nova-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
          </div>
          <span class="text-xl font-bold tracking-tight text-white">NovaSphere Architecture</span>
        </div>
        <p class="text-slate-400 text-sm max-w-md leading-relaxed">
          Production-grade Digital Experience Platform (DXP) engineering benchmark combining Astro v5 Island Architecture, Strapi Headless CMS, Supabase PostgreSQL, and Vercel edge deployment.
        </p>
        <div class="flex items-center gap-4 text-xs font-mono text-slate-400">
          <span class="inline-flex items-center gap-1.5 text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            All Edge Systems Nominal
          </span>
          <span>•</span>
          <span>Lead: Eka Prasetyo</span>
        </div>
      </div>

      <!-- Navigation Column -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono uppercase tracking-widest text-nova-cyan font-semibold">Platform & Docs</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="/" class="hover:text-white transition-colors">Overview</a></li>
          <li><a href="/architecture" class="hover:text-white transition-colors">System Architecture</a></li>
          <li><a href="/projects" class="hover:text-white transition-colors">Case Studies & Projects</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">Engineering Insights</a></li>
        </ul>
      </div>

      <!-- Tech Stack Column -->
      <div class="space-y-3">
        <h4 class="text-xs font-mono uppercase tracking-widest text-nova-violet font-semibold">Ecosystem</h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-nova-cyan"></span>
            Astro v5 (Islands & SSR)
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-nova-indigo"></span>
            Strapi v5 (Headless CMS)
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Supabase (PostgreSQL 15+)
          </li>
          <li class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-200"></span>
            Vercel (Global Edge Network)
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom credits -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {currentYear} NovaSphere. Designed & Architected by <a href="https://github.com/eka0789" class="text-slate-300 hover:text-nova-cyan font-medium">Eka Prasetyo (@eka0789)</a>.</p>
      <div class="flex items-center gap-6">
        <a href="https://github.com/eka0789" target="_blank" class="hover:text-nova-cyan transition-colors">GitHub Repository</a>
        <a href="/architecture" class="hover:text-nova-cyan transition-colors">Architecture Blueprints</a>
        <a href="/api/health" class="hover:text-nova-cyan transition-colors font-mono">/api/health</a>
      </div>
    </div>
  </div>
</footer>
