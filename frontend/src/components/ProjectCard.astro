---
import type { Project } from '../lib/types';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="glass-card rounded-2xl overflow-hidden flex flex-col justify-between group border border-white/5 hover:border-nova-cyan/40 transition-all duration-300">
  
  <!-- Image Container -->
  <div class="relative h-52 overflow-hidden bg-dark-900">
    <img
      src={project.coverUrl}
      alt={project.title}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-dark-950 via-dark-950/40 to-transparent"></div>
    
    <!-- Category Badge -->
    <div class="absolute top-4 left-4">
      <span class="px-3 py-1 rounded-full text-[11px] font-mono font-medium bg-dark-950/80 text-nova-cyan border border-nova-cyan/30 backdrop-blur-md">
        {project.category}
      </span>
    </div>

    <!-- Client Tag -->
    <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between">
      <span class="text-xs font-medium text-slate-300">
        {project.client}
      </span>
      {project.featured && (
        <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-amber-500/20 text-amber-300 border border-amber-500/30">
          Featured
        </span>
      )}
    </div>
  </div>

  <!-- Content Section -->
  <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
    <div>
      <h3 class="text-xl font-bold text-white group-hover:text-nova-cyan transition-colors mb-2">
        {project.title}
      </h3>
      <p class="text-xs text-nova-violet font-medium mb-3">
        {project.tagline}
      </p>
      <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
        {project.description}
      </p>
    </div>

    <!-- Metrics Strip -->
    {project.metrics && Object.keys(project.metrics).length > 0 && (
      <div class="grid grid-cols-3 gap-2 py-3 px-3 rounded-xl bg-dark-950/70 border border-white/5 font-mono text-center">
        {Object.entries(project.metrics).slice(0, 3).map(([key, val]) => (
          <div>
            <span class="block text-[9px] uppercase tracking-wider text-slate-500">{key}</span>
            <span class="text-xs font-bold text-emerald-400">{val}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Tech Stack & Links -->
    <div class="pt-3 border-t border-white/5 flex items-center justify-between">
      <div class="flex flex-wrap gap-1">
        {project.techStack.slice(0, 3).map((tech) => (
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-white/5 text-slate-300 border border-white/5">
            {tech}
          </span>
        ))}
        {project.techStack.length > 3 && (
          <span class="text-[10px] font-mono px-1.5 py-0.5 text-slate-500">
            +{project.techStack.length - 3}
          </span>
        )}
      </div>

      <a
        href={project.externalUrl || `https://github.com/eka0789`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-medium text-slate-300 hover:text-nova-cyan flex items-center gap-1 transition-colors"
      >
        <span>Repo</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>

  </div>

</article>
