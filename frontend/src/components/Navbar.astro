---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: 'Overview', href: '/', badge: null },
  { name: 'Architecture', href: '/architecture', badge: 'C4' },
  { name: 'Telemetry', href: '/telemetry', badge: 'Live SRE' },
  { name: 'Projects', href: '/projects', badge: null },
  { name: 'Engineering Blog', href: '/blog', badge: 'Insights' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="main-header">
  <!-- Dynamic blur backdrop with gradient border bottom -->
  <div class="glass-panel border-b border-white/[0.08] shadow-2xl shadow-dark-950/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand Logo with animated holographic hover effect -->
      <a href="/" class="flex items-center gap-3.5 group relative">
        <div class="relative w-11 h-11 rounded-2xl bg-gradient-to-br from-nova-cyan via-nova-indigo to-nova-violet p-[1.5px] shadow-lg shadow-nova-cyan/20 group-hover:shadow-nova-cyan/40 group-hover:scale-105 transition-all duration-300">
          <div class="w-full h-full bg-dark-950 rounded-[14px] flex items-center justify-center overflow-hidden relative">
            <!-- Animated inner glow -->
            <div class="absolute inset-0 bg-gradient-to-tr from-nova-cyan/20 to-nova-violet/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <svg class="w-5 h-5 text-nova-cyan group-hover:rotate-12 group-hover:scale-110 transition-transform duration-300 relative z-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
              <polyline points="2 17 12 22 22 17"></polyline>
              <polyline points="2 12 12 17 22 12"></polyline>
            </svg>
          </div>
        </div>
        
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="text-xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-100 to-nova-cyan-glow">
              NovaSphere
            </span>
            <span class="px-1.5 py-0.2 rounded text-[10px] font-mono font-bold bg-nova-indigo/20 text-nova-indigo-glow border border-nova-indigo/30">
              v5
            </span>
          </div>
          <span class="text-[10px] font-mono tracking-widest text-slate-400 group-hover:text-nova-cyan transition-colors uppercase flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-nova-cyan animate-pulse"></span>
            Astro × Strapi × Supabase
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Pill with animated background -->
      <nav class="hidden md:flex items-center gap-1 bg-dark-900/80 p-1.5 rounded-2xl border border-white/10 backdrop-blur-xl shadow-inner">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`relative px-4 py-2 text-xs font-semibold rounded-xl transition-all duration-300 flex items-center gap-1.5 ${
                isActive
                  ? 'bg-gradient-to-r from-nova-indigo/40 via-nova-violet/30 to-nova-cyan/20 text-white border border-nova-cyan/30 shadow-md shadow-nova-indigo/20'
                  : 'text-slate-400 hover:text-white hover:bg-white/[0.06]'
              }`}
            >
              <span>{item.name}</span>
              {item.badge && (
                <span class={`text-[9px] font-mono px-1.5 py-0.2 rounded ${
                  isActive ? 'bg-nova-cyan text-dark-950 font-bold' : 'bg-white/10 text-slate-300'
                }`}>
                  {item.badge}
                </span>
              )}
            </a>
          );
        })}
      </nav>

      <!-- Right Action Toolbar -->
      <div class="flex items-center gap-3">
        <!-- Quick Omnibar Trigger Button (Cmd+K) -->
        <button
          type="button"
          onclick="window.openOmnibar && window.openOmnibar()"
          class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-dark-900 border border-white/10 hover:border-nova-cyan/50 text-slate-300 hover:text-white transition-all text-xs font-mono shadow-sm group"
        >
          <svg class="w-3.5 h-3.5 text-nova-cyan group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8" stroke-width="2"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65" stroke-width="2"></line>
          </svg>
          <span class="hidden xl:inline text-slate-400">Search</span>
          <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-[10px] text-slate-300 font-bold border border-white/10">⌘K</kbd>
        </button>

        <!-- Live Edge Status Pill -->
        <a 
          href="/api/health" 
          target="_blank"
          title="Inspect live JSON Telemetry & Edge Health"
          class="hidden lg:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-xs font-mono transition-all duration-200 group"
        >
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
          </span>
          <span class="group-hover:text-white transition-colors">Vercel Edge &lt;28ms</span>
        </a>

        <!-- GitHub Profile button with glowing hover -->
        <a
          href="https://github.com/eka0789"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-xl bg-white/[0.08] hover:bg-white/[0.14] text-white border border-white/10 hover:border-nova-cyan/50 shadow-lg shadow-black/40 hover:shadow-nova-cyan/20 transition-all duration-300 hover:scale-[1.03] active:scale-[0.98] group"
        >
          <svg class="w-4 h-4 text-slate-300 group-hover:text-nova-cyan transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
          </svg>
          <span class="hidden sm:inline font-mono">eka0789</span>
        </a>

        <!-- Mobile Menu Hamburger -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden p-2.5 rounded-xl bg-dark-900 border border-white/10 text-slate-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-nova-cyan"
          aria-label="Toggle navigation menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown with Slide-Down Animation -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pt-3 pb-6 border-b border-white/10 bg-dark-950/98 backdrop-blur-2xl shadow-2xl animate-in slide-in-from-top duration-200">
    <div class="flex flex-col space-y-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-4 py-3 rounded-xl text-sm font-medium text-slate-300 hover:text-white hover:bg-white/[0.07] transition-all flex items-center justify-between"
        >
          <span>{item.name}</span>
          {item.badge && (
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-nova-cyan/20 text-nova-cyan">
              {item.badge}
            </span>
          )}
        </a>
      ))}
      <div class="pt-3 border-t border-white/10 flex flex-col gap-2">
        <a
          href="https://github.com/eka0789/astro-strapi-enterprise-dxp"
          target="_blank"
          class="flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-xs font-semibold text-nova-cyan bg-nova-cyan/10 border border-nova-cyan/30"
        >
          <span>GitHub Repository</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
