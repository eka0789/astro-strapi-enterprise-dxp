---
import { getProjects, getArticles } from '../lib/strapi';

const { projects } = await getProjects();
const { articles } = await getArticles();

const searchableItems = [
  ...projects.map((p) => ({
    id: p.id,
    title: p.title,
    type: 'Project / Case Study',
    category: p.category,
    description: p.tagline || p.description,
    href: `/projects`,
    badge: 'Case Study',
  })),
  ...articles.map((a) => ({
    id: a.id,
    title: a.title,
    type: 'Engineering Article',
    category: a.category,
    description: a.excerpt,
    href: `/blog/${a.slug}`,
    badge: 'Article',
  })),
  {
    id: 'arch-c4',
    title: 'C4 System Topology & Flowchart',
    type: 'Architecture Blueprint',
    category: 'Architecture',
    description: 'Explore full edge topology diagram, webhooks, and Supabase connection pool specifications.',
    href: '/architecture',
    badge: 'Core Spec',
  },
  {
    id: 'telemetry-dash',
    title: 'Live Telemetry & SRE Dashboard',
    type: 'SRE Observability',
    category: 'Observability',
    description: 'Inspect live p95 edge latency, query performance, and Supabase pooler stats.',
    href: '/telemetry',
    badge: 'SRE',
  },
];
---

<!-- Omnibar Modal Backdrop -->
<div
  id="omnibar-modal"
  class="fixed inset-0 z-50 bg-dark-950/80 backdrop-blur-xl hidden flex items-start justify-center pt-24 px-4 transition-opacity duration-200"
  role="dialog"
  aria-modal="true"
  aria-labelledby="omnibar-input"
>
  <!-- Search Dialog Container -->
  <div
    id="omnibar-dialog"
    class="w-full max-w-2xl rounded-3xl glass-card border border-white/20 shadow-2xl overflow-hidden shadow-nova-cyan/10 animate-in fade-in zoom-in-95 duration-200"
  >
    <!-- Search Input Bar -->
    <div class="relative flex items-center px-6 py-4.5 border-b border-white/10 bg-dark-900/90">
      <svg class="w-5 h-5 text-nova-cyan mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8" stroke-width="2"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65" stroke-width="2"></line>
      </svg>
      <input
        id="omnibar-search-input"
        type="text"
        placeholder="Type to search case studies, articles, or architectural nodes... (Esc to close)"
        class="w-full bg-transparent text-white placeholder-slate-400 text-sm sm:text-base focus:outline-none font-sans"
        autocomplete="off"
      />
      <div class="flex items-center gap-1.5 ml-2">
        <kbd class="px-2 py-0.5 rounded-lg bg-white/10 border border-white/10 text-[10px] font-mono text-slate-400">ESC</kbd>
      </div>
    </div>

    <!-- Quick Shortcuts / Tips -->
    <div class="px-6 py-2.5 bg-dark-950/80 border-b border-white/5 flex items-center justify-between text-[11px] font-mono text-slate-400">
      <div class="flex items-center gap-3">
        <span>Semantic Search Active</span>
        <span>•</span>
        <span class="text-nova-cyan">Tip: Try "Fintech", "Latency", or "Supabase"</span>
      </div>
      <span id="results-count" class="text-slate-400">{searchableItems.length} indexed items</span>
    </div>

    <!-- Results List -->
    <div id="omnibar-results" class="max-h-96 overflow-y-auto p-3 space-y-1.5 custom-scrollbar">
      {searchableItems.map((item) => (
        <a
          href={item.href}
          class="omnibar-item block p-3.5 rounded-2xl bg-white/[0.02] hover:bg-white/[0.07] border border-transparent hover:border-nova-cyan/40 transition-all duration-200 group"
          data-title={item.title.toLowerCase()}
          data-category={item.category.toLowerCase()}
          data-desc={item.description.toLowerCase()}
        >
          <div class="flex items-center justify-between gap-2 mb-1">
            <h4 class="text-sm font-bold text-white group-hover:text-nova-cyan transition-colors line-clamp-1">
              {item.title}
            </h4>
            <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded-md bg-white/5 border border-white/10 text-slate-300 shrink-0">
              {item.badge}
            </span>
          </div>
          <p class="text-xs text-slate-400 line-clamp-1">
            {item.description}
          </p>
          <div class="mt-2 flex items-center gap-2 text-[10px] font-mono text-slate-500">
            <span class="text-nova-violet">{item.type}</span>
            <span>&bull;</span>
            <span>{item.category}</span>
          </div>
        </a>
      ))}
      <div id="no-results" class="hidden py-10 text-center text-slate-400 text-xs font-mono">
        No matching resources found. Try another query.
      </div>
    </div>

    <!-- Dialog Footer -->
    <div class="px-6 py-3 bg-dark-950 border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-slate-400">
      <div class="flex items-center gap-4">
        <span><kbd class="text-slate-300 font-bold">&uarr;&darr;</kbd> to navigate</span>
        <span><kbd class="text-slate-300 font-bold">&crarr;</kbd> to open</span>
      </div>
      <span class="text-nova-cyan font-bold">NovaSphere Omnibar</span>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('omnibar-modal');
  const input = document.getElementById('omnibar-search-input') as HTMLInputElement;
  const items = document.querySelectorAll('.omnibar-item');
  const countDisplay = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');

  function openOmnibar() {
    if (modal && input) {
      modal.classList.remove('hidden');
      setTimeout(() => input.focus(), 50);
    }
  }

  function closeOmnibar() {
    if (modal && input) {
      modal.classList.add('hidden');
      input.value = '';
      filterItems('');
    }
  }

  function filterItems(query: string) {
    const q = query.toLowerCase().trim();
    let visibleCount = 0;

    items.forEach((el) => {
      const item = el as HTMLElement;
      const title = item.getAttribute('data-title') || '';
      const cat = item.getAttribute('data-category') || '';
      const desc = item.getAttribute('data-desc') || '';

      if (!q || title.includes(q) || cat.includes(q) || desc.includes(q)) {
        item.style.display = 'block';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    if (countDisplay) {
      countDisplay.textContent = `${visibleCount} item${visibleCount === 1 ? '' : 's'}`;
    }

    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  // Keyboard shortcut listener: Cmd + K or Ctrl + K
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      if (modal?.classList.contains('hidden')) {
        openOmnibar();
      } else {
        closeOmnibar();
      }
    } else if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
      closeOmnibar();
    }
  });

  // Modal click outside to dismiss
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeOmnibar();
    }
  });

  // Search input typing listener
  input?.addEventListener('input', (e) => {
    filterItems((e.target as HTMLInputElement).value);
  });

  // Expose trigger globally for button clicks
  (window as any).openOmnibar = openOmnibar;
</script>
