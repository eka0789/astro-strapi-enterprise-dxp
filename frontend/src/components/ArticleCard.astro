---
import type { Article } from '../lib/types';

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<article class="glass-card rounded-2xl overflow-hidden flex flex-col justify-between group border border-white/5 hover:border-nova-violet/40 transition-all duration-300">
  <!-- Image Banner -->
  <div class="relative h-48 overflow-hidden bg-dark-900">
    <img
      src={article.coverUrl}
      alt={article.title}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-dark-950 via-dark-950/30 to-transparent"></div>
    <div class="absolute top-4 left-4 flex gap-2">
      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-dark-950/80 text-nova-violet border border-nova-violet/30 backdrop-blur-md">
        {article.category}
      </span>
    </div>
    <div class="absolute bottom-3 right-4">
      <span class="text-[10px] font-mono text-slate-300 bg-dark-900/80 px-2 py-0.5 rounded">
        {article.readingTime}
      </span>
    </div>
  </div>

  <!-- Content -->
  <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
    <div>
      <h3 class="text-lg font-bold text-white group-hover:text-nova-violet transition-colors mb-2 leading-snug">
        <a href={`/blog/${article.slug}`}>
          {article.title}
        </a>
      </h3>
      <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
        {article.excerpt}
      </p>
    </div>

    <!-- Author & Read More Link -->
    <div class="pt-4 border-t border-white/5 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-nova-indigo to-nova-cyan flex items-center justify-center text-[10px] font-bold text-white">
          EP
        </div>
        <span class="text-xs font-medium text-slate-300">{article.author}</span>
      </div>

      <a
        href={`/blog/${article.slug}`}
        class="text-xs font-semibold text-nova-cyan group-hover:text-white flex items-center gap-1 transition-colors"
      >
        <span>Read Article</span>
        <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</article>
