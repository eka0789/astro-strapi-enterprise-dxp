---
interface Props {
  source?: 'strapi' | 'fallback';
}

const { source = 'fallback' } = Astro.props;
---

<section class="relative pt-12 pb-20 lg:pt-20 lg:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Headline & Value Proposition -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        
        <!-- Role & Architectural Badge -->
        <div class="inline-flex items-center gap-3 p-1.5 pr-4 rounded-full bg-dark-900/80 border border-white/10 backdrop-blur-xl shadow-lg hover:border-nova-cyan/50 transition-all duration-300">
          <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-gradient-to-r from-nova-indigo to-nova-cyan text-white shadow-sm">
            Senior Fullstack & Solution Architect
          </span>
          <span class="text-xs text-slate-300 font-medium flex items-center gap-1.5">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Enterprise Grade DXP
          </span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12]">
          Unified Edge Architecture with <br class="hidden sm:inline" />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-nova-cyan via-nova-indigo to-nova-violet">
            Astro v5
          </span>
          <span class="text-slate-300"> & </span>
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-nova-violet via-pink-400 to-nova-cyan">
            Strapi CMS
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Production-tested architectural blueprint orchestrating zero-JS Astro Island frontends, decoupled Strapi Headless CMS content governance, transactional Supabase PostgreSQL, and global Vercel Edge caching.
        </p>

        <!-- Tech Stack Pill Ribbon -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2.5 pt-2">
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-dark-900/80 border border-white/10 text-xs font-mono text-slate-200">
            <span class="w-2 h-2 rounded-full bg-nova-cyan"></span>
            <span>Astro v5</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-dark-900/80 border border-white/10 text-xs font-mono text-slate-200">
            <span class="w-2 h-2 rounded-full bg-nova-indigo"></span>
            <span>Strapi Headless CMS</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-dark-900/80 border border-white/10 text-xs font-mono text-slate-200">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span>Supabase PostgreSQL</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-dark-900/80 border border-white/10 text-xs font-mono text-slate-200">
            <span class="w-2 h-2 rounded-full bg-white"></span>
            <span>Vercel Edge</span>
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="/architecture"
            class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-sm text-white bg-gradient-to-r from-nova-indigo via-nova-violet to-nova-cyan hover:opacity-95 shadow-lg shadow-nova-indigo/25 hover:shadow-nova-cyan/30 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center gap-2.5 group relative overflow-hidden"
          >
            <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent transition-transform duration-1000 ease-in-out"></div>
            <span>Explore Architecture Deep Dive</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="https://github.com/eka0789"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-7 py-3.5 rounded-xl font-semibold text-sm text-slate-200 bg-dark-900/90 hover:bg-dark-800 border border-white/10 hover:border-white/20 hover:text-white transition-all duration-200 flex items-center justify-center gap-2.5"
          >
            <svg class="w-4 h-4 text-slate-400" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
            <span>GitHub @eka0789</span>
          </a>
        </div>

        <!-- Quick Live Telemetry Info -->
        <div class="pt-4 border-t border-white/5 flex items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-mono">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-nova-cyan"></span>
            <span>CMS Mode: <strong class="text-slate-200">{source === 'strapi' ? 'Strapi API Live' : 'Embedded Resilient Seed'}</strong></span>
          </div>
          <div>
            <span>Edge TTFB: <strong class="text-emerald-400">&lt;28ms</strong></span>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Holographic Architecture Terminal & 3D Cards -->
      <div class="lg:col-span-5 relative">
        <!-- Floating Ambient Glow Behind Box -->
        <div class="absolute -inset-2 bg-gradient-to-r from-nova-cyan/20 via-nova-indigo/20 to-nova-violet/20 rounded-3xl blur-2xl opacity-60 animate-pulse-glow"></div>

        <!-- Main Architectural Card -->
        <div class="relative glass-card rounded-2xl p-6 border border-white/10 shadow-2xl space-y-6">
          
          <!-- Terminal Header -->
          <div class="flex items-center justify-between pb-4 border-b border-white/10">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80"></div>
              <span class="text-xs font-mono text-slate-400 ml-2">novasphere-orchestrator.ts</span>
            </div>
            <span class="text-[10px] font-mono text-nova-cyan px-2 py-0.5 rounded bg-nova-cyan/10 border border-nova-cyan/20">
              Active v5.0.4
            </span>
          </div>

          <!-- Code Stream Visualizer -->
          <div class="space-y-3 font-mono text-xs text-slate-300 bg-dark-950/80 p-4 rounded-xl border border-white/5">
            <div class="flex items-center justify-between text-slate-400">
              <span>// 1. Client Request (Edge CDN)</span>
              <span class="text-emerald-400">200 OK</span>
            </div>
            <p class="text-nova-cyan">GET /api/experience -> Edge Region SIN1</p>
            
            <div class="pt-2 border-t border-white/5 text-slate-400">
              <span>// 2. Headless Content Resolution</span>
            </div>
            <p class="text-nova-violet">Strapi.query('projects').populate()</p>
            
            <div class="pt-2 border-t border-white/5 text-slate-400">
              <span>// 3. PostgreSQL Transaction Pooler</span>
            </div>
            <p class="text-emerald-400">Supavisor: pooled connection (10k QPS)</p>
          </div>

          <!-- Metric Gauges -->
          <div class="grid grid-cols-3 gap-3 text-center font-mono">
            <div class="p-3 rounded-xl bg-white/[0.03] border border-white/5">
              <span class="block text-[11px] text-slate-400 uppercase">Core Vitals</span>
              <span class="text-lg font-bold text-emerald-400">100/100</span>
            </div>
            <div class="p-3 rounded-xl bg-white/[0.03] border border-white/5">
              <span class="block text-[11px] text-slate-400 uppercase">Hydration</span>
              <span class="text-lg font-bold text-nova-cyan">Selective</span>
            </div>
            <div class="p-3 rounded-xl bg-white/[0.03] border border-white/5">
              <span class="block text-[11px] text-slate-400 uppercase">Edge TTL</span>
              <span class="text-lg font-bold text-nova-indigo">Instant ISR</span>
            </div>
          </div>

          <!-- Floating Badges Animation -->
          <div class="relative pt-2">
            <div class="p-3 rounded-xl bg-gradient-to-r from-nova-indigo/20 to-nova-cyan/20 border border-white/10 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-nova-cyan/20 flex items-center justify-center text-nova-cyan">
                  ⚡
                </div>
                <div>
                  <p class="text-xs font-bold text-white">Vercel Deploy Webhook</p>
                  <p class="text-[11px] text-slate-400">Auto-invalidates on Strapi publish</p>
                </div>
              </div>
              <span class="text-xs text-emerald-400 font-mono font-bold">LIVE</span>
            </div>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
