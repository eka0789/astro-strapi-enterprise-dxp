---
interface Props {
  source?: 'strapi' | 'fallback';
}

const { source = 'fallback' } = Astro.props;
---

<section class="relative pt-8 pb-20 lg:pt-16 lg:pb-32 overflow-hidden">
  
  <!-- Subtle Glowing Ambient Orbs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[350px] bg-gradient-to-r from-nova-cyan/15 via-nova-indigo/20 to-nova-violet/15 blur-[100px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Vision, Role Badge, and CTAs -->
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        
        <!-- Architectural Status Badge -->
        <div class="inline-flex items-center gap-3 p-1.5 pr-4 rounded-full bg-dark-900/90 border border-white/10 backdrop-blur-2xl shadow-xl hover:border-nova-cyan/50 hover:shadow-nova-cyan/20 transition-all duration-300 group cursor-default">
          <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-gradient-to-r from-nova-indigo via-nova-violet to-nova-cyan text-white shadow-md shadow-nova-indigo/30 group-hover:scale-105 transition-transform">
            Senior Fullstack & Solution Architect
          </span>
          <span class="text-xs text-slate-300 font-medium flex items-center gap-2">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400"></span>
            </span>
            <span>Enterprise DXP Matrix</span>
          </span>
        </div>

        <!-- Hero Headline with Shimmer Gradient -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white leading-[1.08]">
          Ultra-Fast Edge DXP with <br class="hidden sm:inline" />
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-nova-cyan via-nova-indigo-glow to-nova-violet animate-gradient-shift bg-[length:200%_auto]">
            Astro v5
          </span>
          <span class="text-slate-300"> & </span>
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-nova-violet via-pink-400 to-nova-cyan-glow">
            Strapi CMS
          </span>
        </h1>

        <!-- Subtitle Prose -->
        <p class="text-base sm:text-lg lg:text-xl text-slate-300 font-normal leading-relaxed max-w-2xl mx-auto lg:mx-0">
          Decoupling editorial content creation from edge rendering velocity. Built with zero-JS Astro Islands, resilient Strapi Headless CMS pipelines, Supabase PostgreSQL pooling, and instant Vercel invalidation.
        </p>

        <!-- Tech Stack Pill Ribbon -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 pt-1">
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-dark-900/90 border border-white/10 text-xs font-mono text-slate-200 hover:border-nova-cyan/40 transition-colors shadow-sm">
            <span class="w-2 h-2 rounded-full bg-nova-cyan shadow-sm shadow-nova-cyan"></span>
            <span>Astro v5 Islands</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-dark-900/90 border border-white/10 text-xs font-mono text-slate-200 hover:border-nova-indigo/40 transition-colors shadow-sm">
            <span class="w-2 h-2 rounded-full bg-nova-indigo shadow-sm shadow-nova-indigo"></span>
            <span>Strapi Headless CMS</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-dark-900/90 border border-white/10 text-xs font-mono text-slate-200 hover:border-emerald-400/40 transition-colors shadow-sm">
            <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400"></span>
            <span>Supabase Postgres</span>
          </div>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-dark-900/90 border border-white/10 text-xs font-mono text-slate-200 hover:border-white/40 transition-colors shadow-sm">
            <span class="w-2 h-2 rounded-full bg-white shadow-sm shadow-white"></span>
            <span>Vercel Global Edge</span>
          </div>
        </div>

        <!-- Action CTAs with Glow and Shimmer -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="/architecture"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl font-bold text-sm text-white bg-gradient-to-r from-nova-indigo via-nova-violet to-nova-cyan hover:opacity-95 shadow-xl shadow-nova-indigo/30 hover:shadow-nova-cyan/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-3 group relative overflow-hidden"
          >
            <!-- Animated shimmer line inside button -->
            <div class="absolute inset-0 -translate-x-full group-hover:translate-x-full bg-gradient-to-r from-transparent via-white/25 to-transparent transition-transform duration-1000 ease-in-out"></div>
            <span>Explore Architecture Blueprint</span>
            <svg class="w-4 h-4 group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a
            href="https://github.com/eka0789/astro-strapi-enterprise-dxp"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-7 py-4 rounded-2xl font-semibold text-sm text-slate-200 bg-dark-900/90 hover:bg-dark-800 border border-white/10 hover:border-nova-cyan/40 hover:text-white shadow-lg transition-all duration-300 flex items-center justify-center gap-2.5 group"
          >
            <svg class="w-4 h-4 text-slate-400 group-hover:text-nova-cyan transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
            </svg>
            <span>Star Repository</span>
          </a>
        </div>

        <!-- Telemetry Status Bar -->
        <div class="pt-4 border-t border-white/5 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-400 font-mono">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-nova-cyan"></span>
            <span>CMS Connection: <strong class="text-slate-200">{source === 'strapi' ? 'Strapi API Live' : 'Embedded Resilient Fixture'}</strong></span>
          </div>
          <div>
            <span>Edge TTFB: <strong class="text-emerald-400">&lt;28ms Global</strong></span>
          </div>
        </div>

      </div>

      <!-- Right Column: Animated Holographic Architecture Pod -->
      <div class="lg:col-span-5 relative">
        <!-- Glowing aura backdrop -->
        <div class="absolute -inset-2 bg-gradient-to-r from-nova-cyan/25 via-nova-indigo/25 to-nova-violet/25 rounded-3xl blur-2xl opacity-70 animate-pulse-glow"></div>

        <!-- Glass Terminal Container -->
        <div class="relative glass-card rounded-3xl p-6 sm:p-7 border border-white/10 shadow-2xl space-y-6">
          
          <!-- Terminal Titlebar -->
          <div class="flex items-center justify-between pb-4 border-b border-white/10">
            <div class="flex items-center gap-2.5">
              <div class="w-3 h-3 rounded-full bg-rose-500/80 shadow-sm shadow-rose-500/50"></div>
              <div class="w-3 h-3 rounded-full bg-amber-500/80 shadow-sm shadow-amber-500/50"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500/80 shadow-sm shadow-emerald-500/50"></div>
              <span class="text-xs font-mono text-slate-400 ml-2">novasphere-telemetry.ts</span>
            </div>
            <span class="text-[10px] font-mono text-nova-cyan px-2.5 py-1 rounded-lg bg-nova-cyan/10 border border-nova-cyan/30 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-nova-cyan animate-ping"></span>
              Active Node
            </span>
          </div>

          <!-- Code Stream Visualizer -->
          <div class="space-y-3 font-mono text-xs text-slate-300 bg-dark-950/90 p-4.5 rounded-2xl border border-white/5 shadow-inner">
            <div class="flex items-center justify-between text-slate-400">
              <span class="flex items-center gap-1.5">
                <span class="text-nova-cyan">&gt;</span> Edge Gateway Ingress
              </span>
              <span class="text-emerald-400 font-bold">200 OK</span>
            </div>
            <p class="text-slate-300">GET /api/experience <span class="text-slate-500">→</span> <span class="text-nova-cyan">Edge PoP (SIN1)</span></p>
            
            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-slate-400">
              <span class="flex items-center gap-1.5">
                <span class="text-nova-violet">&gt;</span> Headless CMS Resolving
              </span>
              <span class="text-nova-violet text-[11px]">Strapi v5</span>
            </div>
            <p class="text-slate-300 font-mono text-[11px]">Strapi.query('projects').populate('*')</p>
            
            <div class="pt-2 border-t border-white/5 flex items-center justify-between text-slate-400">
              <span class="flex items-center gap-1.5">
                <span class="text-emerald-400">&gt;</span> Postgres Pooler (Port 6543)
              </span>
              <span class="text-emerald-400 font-bold">10k QPS</span>
            </div>
            <p class="text-emerald-300/90 text-[11px]">Supavisor Connection: 0 connection leaks</p>
          </div>

          <!-- Metric Gauges -->
          <div class="grid grid-cols-3 gap-3 text-center font-mono">
            <div class="p-3.5 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-emerald-500/30 transition-colors">
              <span class="block text-[10px] text-slate-400 uppercase tracking-wider">Performance</span>
              <span class="text-lg font-extrabold text-emerald-400">100/100</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-nova-cyan/30 transition-colors">
              <span class="block text-[10px] text-slate-400 uppercase tracking-wider">Hydration</span>
              <span class="text-lg font-extrabold text-nova-cyan">Selective</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-white/[0.03] border border-white/5 hover:border-nova-indigo/30 transition-colors">
              <span class="block text-[10px] text-slate-400 uppercase tracking-wider">Edge TTL</span>
              <span class="text-lg font-extrabold text-nova-indigo">Instant ISR</span>
            </div>
          </div>

          <!-- Live Webhook Notification Banner -->
          <div class="p-3.5 rounded-2xl bg-gradient-to-r from-nova-indigo/20 via-nova-violet/20 to-nova-cyan/20 border border-white/10 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-xl bg-nova-cyan/20 border border-nova-cyan/30 flex items-center justify-center text-nova-cyan font-bold">
                ⚡
              </div>
              <div>
                <p class="text-xs font-bold text-white">Event Webhook Bus</p>
                <p class="text-[11px] text-slate-400">Auto-invalidates edge cache on CMS publish</p>
              </div>
            </div>
            <span class="text-xs text-emerald-400 font-mono font-bold bg-emerald-500/10 px-2.5 py-1 rounded-lg border border-emerald-500/20">
              SYNCHRONIZED
            </span>
          </div>

        </div>

      </div>

    </div>
  </div>
</section>
