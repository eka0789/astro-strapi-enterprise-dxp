---
import { architectureMetrics } from '../lib/mock-data';

const pillars = [
  {
    role: 'Frontend Layer',
    title: 'Astro v5 Islands & Partial Hydration',
    description: 'Renders static HTML by default at the edge. Hydrates only isolated client components when in viewport, reducing client-side JS by up to 90%.',
    icon: 'astro',
    color: 'from-orange-500 to-amber-500',
    borderColor: 'hover:border-amber-500/50',
    tags: ['Astro Islands', 'Hybrid Rendering', 'Zero JS Baseline', 'Tailwind CSS'],
    status: 'Zero JS Payload',
  },
  {
    role: 'Content & Governance Layer',
    title: 'Strapi v5 Headless CMS',
    description: 'Decoupled authoring environment exposing GraphQL & REST endpoints. Dispatches instant build webhooks upon content publishing.',
    icon: 'strapi',
    color: 'from-indigo-500 to-purple-600',
    borderColor: 'hover:border-indigo-500/50',
    tags: ['REST & GraphQL', 'Role-Based Access', 'Automated Webhooks', 'Dynamic Schema'],
    status: 'Event-Driven Bus',
  },
  {
    role: 'Data Persistence Layer',
    title: 'Supabase PostgreSQL & Vector',
    description: 'High availability relational Postgres with Supavisor transaction connection pooling, Row Level Security (RLS), and sub-millisecond query caching.',
    icon: 'supabase',
    color: 'from-emerald-500 to-teal-500',
    borderColor: 'hover:border-emerald-500/50',
    tags: ['PgBouncer/Supavisor', 'Row-Level Security', 'ACID Compliant', 'Automated Backups'],
    status: '10k+ QPS Pooler',
  },
  {
    role: 'Delivery & Edge Layer',
    title: 'Vercel Global Edge Network',
    description: 'Multi-region serverless and edge compute with automatic TLS, Brotli compression, and distributed CDN spanning over 300 points of presence.',
    icon: 'vercel',
    color: 'from-cyan-500 to-blue-600',
    borderColor: 'hover:border-cyan-500/50',
    tags: ['Edge Middleware', 'Smart CDN Caching', 'Instant Previews', 'Zero Cold Start'],
    status: 'Global Sub-30ms',
  },
];
---

<section class="py-20 relative overflow-hidden bg-dark-950/60 border-y border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-nova-indigo/10 border border-nova-indigo/30 text-nova-cyan text-xs font-mono">
        <span>Solution Architecture Blueprint</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        The Four Pillars of the <br />
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-nova-cyan via-nova-indigo to-nova-violet">
          NovaSphere Enterprise Platform
        </span>
      </h2>
      <p class="text-slate-400 text-base leading-relaxed">
        Designed from first principles to decouple content authoring velocity from client rendering latency, securing optimal Core Web Vitals and resilient scalability.
      </p>
    </div>

    <!-- 4 Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {pillars.map((pillar, idx) => (
        <div class={`glass-card rounded-2xl p-6 relative flex flex-col justify-between group ${pillar.borderColor} transition-all duration-300`}>
          <div class="space-y-4">
            <!-- Header with step counter and badge -->
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-slate-500">0{idx + 1}</span>
              <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-full bg-white/5 border border-white/10 text-slate-300">
                {pillar.status}
              </span>
            </div>

            <!-- Role and Title -->
            <div>
              <p class="text-xs font-mono text-nova-cyan uppercase tracking-wider mb-1">{pillar.role}</p>
              <h3 class="text-lg font-bold text-white group-hover:text-nova-cyan transition-colors">
                {pillar.title}
              </h3>
            </div>

            <p class="text-xs text-slate-400 leading-relaxed">
              {pillar.description}
            </p>
          </div>

          <!-- Tags -->
          <div class="pt-6 mt-6 border-t border-white/5">
            <div class="flex flex-wrap gap-1.5">
              {pillar.tags.map((tag) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-dark-900 text-slate-300 border border-white/5">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Metrics Row -->
    <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {architectureMetrics.map((metric) => (
        <div class="p-5 rounded-xl bg-dark-900/60 border border-white/5 flex flex-col justify-between hover:border-white/10 transition-colors">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-mono text-slate-400">{metric.label}</span>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
              {metric.badge}
            </span>
          </div>
          <div class="text-2xl font-extrabold text-white font-mono my-1 tracking-tight">
            {metric.value}
          </div>
          <p class="text-[11px] text-slate-500 leading-normal">
            {metric.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
